{
  "env": "test",
  "serverHost": "127.0.0.1:8089",
  "serverDomain": "https://domain.com",
  "htlcWaitSeconds": 5,
  "minimumPaymentMultiplier": 5,
  "maximumPaymentSat": 1000000,
  "fee": {
    "maxSat": 40000,
    "maxSatPerVByte": 200,
    "subsidyFactor": 1
  },
  "backend": "lnd",
  "backendConfig": {
    "lndNode": "127.0.0.1:9735",
    "grpcServer": "127.0.0.1:10009",
    "cert": "~/.lnd/tls.cert",
    "adminMacaroon": "~/.lnd/data/chain/bitcoin/regtest/admin.macaroon"
  },
  "allowZeroConfChannels": true,
  "allowTaprootChannels": true,
  "rejectPublicPublicHtlcForwards": false,
  "allowLegacySignatures": true,
  "maxOpenRequestsPerPubkey": 100,
  "signedRequestRateLimitPerMinute": 10000,
  "ipRateLimitPerMinute": 10000
}
