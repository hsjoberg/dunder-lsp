{
  "name": "dunder-lsp",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prebuild": "cd src/services/admin/react-admin && NODE_OPTIONS=--openssl-legacy-provider npm run build",
    "postbuild": "cp src/proto.js dist && rm -rf dist/services/admin/public && cp -r src/services/admin/react-admin/build dist/services/admin/public",
    "start": "node --max-http-header-size=32768 dist/server.js",
    "watch": "concurrently \"tsc -p tsconfig.json -w\" \"nodemon -w dist dist/server.js\"",
    "proto": "pbjs --force-long -t static-module -o src/proto.js proto/rpc.proto proto/router.proto && pbts -o src/proto.d.ts src/proto.js",
    "test": "jest tests",
    "regtest": "node regtest/regtest.mjs",
    "regtest:up": "node regtest/regtest.mjs up",
    "regtest:test": "node regtest/regtest.mjs test",
    "regtest:down": "node regtest/regtest.mjs down",
    "test:coverage": "jest --coverage --coveragePathIgnorePatterns \"proto\\.js|mocks\" tests"
  },
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "author": "Hampus Sjöberg",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/session": "^11.1.6",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "@grpc/grpc-js": "^1.9.14",
    "@grpc/proto-loader": "^0.7.10",
    "bech32": "2.0.0",
    "config": "^4.4.1",
    "date-fns": "^2.21.0",
    "fastify": "^5.12.8",
    "protobufjs": "^7.2.6",
    "protobufjs-cli": "^1.1.2",
    "qrcode-terminal": "^0.12.0",
    "secp256k1": "^4.0.2",
    "sql-template-strings": "^2.2.2",
    "sqlite": "^4.1.2",
    "sqlite3": "^6.0.1",
    "sqlstring": "^2.3.2"
  },
  "devDependencies": {
    "@types/config": "^3.3.3",
    "@types/jest": "^26.0.22",
    "@types/node": "^20.11.5",
    "@types/secp256k1": "^4.0.2",
    "@types/sqlstring": "^2.3.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^8.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "stream-mock": "^2.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "wait-for-expect": "^3.0.2"
  }
}
